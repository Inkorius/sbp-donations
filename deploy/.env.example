# Скопируйте в .env и заполните перед запуском:
#   copy .env.example .env

# Домен API (A-запись api.sbpdonation.ru → белый IP)
API_DOMAIN=api.sbpdonation.ru

# Основной домен
SITE_DOMAIN=sbpdonation.ru

# Часовой пояс контейнеров
TZ=Europe/Moscow

# Строка подключения к PostgreSQL (Easypanel → postgres → Учётные данные)
# Пример: postgres://postgres:ПАРОЛЬ@sbp-donation_sbp-db:5432/sbp_donations?sslmode=disable
DATABASE_URL=

# Порт HTTP внутри контейнера API (Target Port в Domains Easypanel)
HTTP_PORT=8080

# Секрет для JWT (длинная случайная строка, не коммитить реальный ключ)
JWT_SECRET=change-me-to-a-long-random-string

# Первый администратор (создаётся при старте, если такого email ещё нет)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Логин и пароль для /docs, /redoc и /openapi.json. Если пусто — документация отключена (404).
DOCS_USER=
DOCS_PASSWORD=

# Откуда браузеру можно вызывать API. Пока * — для тестов.
CORS_ORIGINS=*

# Опционально: ЮKassa (если стример не задал ключи в панели)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# Опционально: «Мой налог» для чеков самозанятых (услуга «Прочие услуги»)
# MOY_NALOG_INN=
# MOY_NALOG_PASSWORD=
